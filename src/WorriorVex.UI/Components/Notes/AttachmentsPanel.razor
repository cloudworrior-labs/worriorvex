@inject Translator T
@using WorriorVex.Application.Attachments
@using WorriorVex.Application.Common
@using WorriorVex.Application.Content
@using WorriorVex.Application.Platform
@using WorriorVex.Domain
@inject IAttachmentService Attachments
@inject IPlatformShell Shell
@inject ILogger<AttachmentsPanel> Logger
@inject WorriorVex.Application.Settings.ISettingsService Settings

@if (_items.Count > 0)
{
    var expanded = Settings.Current.AttachmentsExpanded;
    <section class="wn-attachments @(expanded ? "is-open" : null)" aria-label="@T["Attachments"]">
        <h3>
            <button type="button" class="wn-attachments-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="wn-attachment-list"
                    title="@(expanded ? T["Hide the attached files"] : T["Show the attached files"])" @onclick="ToggleAsync">
                <span aria-hidden="true">@(expanded ? "▾" : "▸")</span> @T["Attachments"] <span class="wn-count">@_items.Count</span>
            </button>
            @if (_unusedImages > 0)
            {
                <button type="button" class="wn-button wn-button-small" title="@T["Remove pictures that no longer appear in the text"]" @onclick="ConfirmRemoveUnused">@T["Remove {0} unused picture(s)", _unusedImages]</button>
            }
        </h3>
        @if (expanded)
        {
        <ul id="wn-attachment-list">
            @foreach (var item in _items)
            {
                var inText = IsInText(item);
                <li @key="item.Id" class="wn-attachment">
                    <span class="wn-attachment-name" title="@item.FileName">@item.FileName</span>
                    <span class="wn-attachment-meta">@FormatSize(item.Size)@(IsImage(item) ? inText ? " · in the text" : " · not in the text" : "")</span>
                    <span class="wn-attachment-actions">
                        <button type="button" class="wn-button wn-button-small" @onclick="() => OpenAsync(item)">@T["Open"]</button>
                        <button type="button" class="wn-button wn-button-small" @onclick="() => SaveCopyAsync(item)">@T["Save as…"]</button>
                        <button type="button" class="wn-button wn-button-small" @onclick="() => _renaming = item">@T["Rename…"]</button>
                        <button type="button" class="wn-button wn-button-small" @onclick="() => _removing = item">@T["Remove…"]</button>
                    </span>
                </li>
            }
        </ul>
        }
    </section>
}

@if (_renaming is { } renaming)
{
    <PromptDialog @key="renaming.Id" Title="@T["Rename attachment"]" Label="@T["File name"]" InitialValue="@renaming.FileName" ConfirmText="@T["Rename"]"
                  MaxLength="Attachment.MaxFileNameLength" Error="@_dialogError" OnConfirm="RenameAsync" OnCancel="CloseDialogs" />
}

@if (_removing is { } removing)
{
    <ConfirmDialog @key="removing.Id" Title="@T["Remove “{0}”?", removing.FileName]"
                   Message="@(IsImage(removing) && IsInText(removing) ? T["The picture is still in the text; it would show as missing. The file is removed for good."] : T["The file is removed for good. The note itself stays."])"
                   ConfirmText="@T["Remove"]" Danger="true" OnConfirm="RemoveAsync" OnCancel="CloseDialogs" />
}

@if (_removingUnused)
{
    <ConfirmDialog Title="@T["Remove unused pictures?"]" Message="@T["{0} picture(s) attached to this note no longer appear in its text. Their files are removed for good.", _unusedImages]"
                   ConfirmText="@T["Remove"]" Danger="true" OnConfirm="RemoveUnusedAsync" OnCancel="CloseDialogs" />
}

@code {
    private List<AttachmentInfo> _items = [];
    private Guid _loadedFor;
    private int _loadedVersion = -1;
    private int _unusedImages;
    private AttachmentInfo? _renaming;
    private AttachmentInfo? _removing;
    private bool _removingUnused;
    private string? _dialogError;

    [Parameter, EditorRequired] public Guid NoteId { get; set; }

    /// <summary>The note's current text, to tell which pictures are still in it.</summary>
    [Parameter] public string Content { get; set; } = string.Empty;

    /// <summary>Raise when attachments were added elsewhere (an image pasted or inserted), so the list is read again.</summary>
    [Parameter] public int Version { get; set; }

    [Parameter] public EventCallback<string> OnProblem { get; set; }

    /// <summary>The attachments changed; counts shown elsewhere may need a refresh.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (NoteId != _loadedFor || Version != _loadedVersion)
        {
            _loadedFor = NoteId;
            _loadedVersion = Version;
            CloseDialogs();
            await LoadAsync();
        }

        _unusedImages = _items.Count(i => IsImage(i) && !IsInText(i));
    }

    private async Task LoadAsync()
    {
        try
        {
            _items = [.. await Attachments.ListAsync(NoteId)];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Attachments could not be listed");
            await OnProblem.InvokeAsync(T["The attachments could not be listed."]);
        }
    }

    private static bool IsImage(AttachmentInfo item) => NoteContentRules.IsAttachmentImageSource(NoteContentRules.AttachmentSource(item.StoredFileName));

    private bool IsInText(AttachmentInfo item) => Content.Contains(NoteContentRules.AttachmentSource(item.StoredFileName), StringComparison.Ordinal);

    private static string FormatSize(long bytes)
    {
        // Written as if/else: the Razor parser mistakes a relational pattern for a markup tag.
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / (1024.0 * 1024.0):0.#} MB";
        }

        return bytes >= 1024 ? $"{bytes / 1024.0:0.#} KB" : $"{bytes} B";
    }

    private async Task OpenAsync(AttachmentInfo item)
    {
        try
        {
            Shell.OpenFile(await Attachments.GetFilePathAsync(item.Id));
        }
        catch (Exception ex) when (ex is FileNotFoundException or EntityNotFoundException)
        {
            await OnProblem.InvokeAsync(T["The file for “{0}” is missing.", item.FileName]);
        }
    }

    private async Task SaveCopyAsync(AttachmentInfo item)
    {
        var destination = await Shell.PickSaveLocationAsync(T["Save a copy"], item.FileName);
        if (destination is null)
        {
            return;
        }

        try
        {
            await Attachments.SaveCopyAsync(item.Id, destination);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or FileNotFoundException or EntityNotFoundException)
        {
            Logger.LogError(ex, "Saving a copy of an attachment failed");
            await OnProblem.InvokeAsync(T["“{0}” could not be saved there.", item.FileName]);
        }
    }

    private async Task RenameAsync(string name)
    {
        if (_renaming is not { } item)
        {
            return;
        }

        try
        {
            var renamed = await Attachments.RenameAsync(item.Id, name);
            _items[_items.FindIndex(i => i.Id == item.Id)] = renamed;
            CloseDialogs();
            await OnChanged.InvokeAsync();
        }
        catch (DomainException ex)
        {
            _dialogError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Renaming an attachment failed");
            _dialogError = T["The attachment could not be renamed."];
        }
    }

    private async Task RemoveAsync()
    {
        if (_removing is not { } item)
        {
            return;
        }

        CloseDialogs();
        try
        {
            await Attachments.DeleteAsync(item.Id);
            _items.RemoveAll(i => i.Id == item.Id);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Removing an attachment failed");
            await OnProblem.InvokeAsync(T["“{0}” could not be removed.", item.FileName]);
        }
    }

    private void ConfirmRemoveUnused() => _removingUnused = true;

    private async Task RemoveUnusedAsync()
    {
        CloseDialogs();
        var unused = _items.Where(i => IsImage(i) && !IsInText(i)).ToList();
        foreach (var item in unused)
        {
            try
            {
                await Attachments.DeleteAsync(item.Id);
                _items.RemoveAll(i => i.Id == item.Id);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Removing an unused picture failed");
                await OnProblem.InvokeAsync(T["“{0}” could not be removed.", item.FileName]);
            }
        }

        await OnChanged.InvokeAsync();
    }

    private void CloseDialogs()
    {
        _renaming = null;
        _removing = null;
        _removingUnused = false;
        _dialogError = null;
    }

    private async Task ToggleAsync()
    {
        try
        {
            await Settings.SaveAsync(Settings.Current with { AttachmentsExpanded = !Settings.Current.AttachmentsExpanded });
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "The attachments panel state could not be remembered");
        }
    }
}
