@implements IAsyncDisposable
@using WorriorVex.Application.Attachments
@using WorriorVex.Application.Content
@using WorriorVex.Application.Platform
@using WorriorVex.Domain
@inject IJSRuntime JS
@inject Translator T
@inject IAttachmentService Attachments
@inject IPlatformShell Shell
@inject ILogger<NoteEditor> Logger
@inject WorriorVex.Application.Settings.ISettingsService Settings

<section class="wn-editor" aria-label="@T["Editor"]">
    <div class="wn-title-row">
        <input @ref="_titleInput"
               class="wn-title"
               type="text"
               value="@_title"
               maxlength="500"
               placeholder="@T["Untitled"]"
               aria-label="@T["Note title"]"
               spellcheck="@(Settings.Current.SpellCheck ? "true" : "false")"
               @oninput="OnTitleInput"
               @onkeydown="OnTitleKeyDown" />
        <button type="button" class="wn-tool @(Note.IsFavorite ? "is-active" : null)" title="@(Note.IsFavorite ? T["Remove from favorites"] : T["Add to favorites"])"
                aria-pressed="@(Note.IsFavorite ? "true" : "false")" @onclick="() => OnToggleFavorite.InvokeAsync()">@(Note.IsFavorite ? "★" : "☆") @T["Favorite"]</button>
        <button type="button" class="wn-tool @(Note.IsPinned ? "is-active" : null)" title="@(Note.IsPinned ? T["Unpin from the top of its list"] : T["Pin to the top of its list"])"
                aria-pressed="@(Note.IsPinned ? "true" : "false")" @onclick="() => OnTogglePinned.InvokeAsync()">⌖ @T["Pin"]</button>
        <button type="button" class="wn-tool" title="@T["Move this note to the trash"]" @onclick="OnDelete">@T["Delete"]</button>
    </div>

    <TagEditor NoteId="Note.Id" OnChanged="OnTagsChanged" />

    @* Pressing a mouse button on the toolbar must not take focus (and the selection) away from the text. *@
    <div class="wn-toolbar" role="toolbar" aria-label="@T["Formatting"]">
        @foreach (var group in ToolbarGroups)
        {
            <div class="wn-toolbar-group">
                @foreach (var item in group)
                {
                    var active = _active.Contains(item.Command);
                    <button type="button"
                            class="wn-tool @(active ? "is-active" : null)"
                            title="@T[item.Label]"
                            aria-label="@T[item.Label]"
                            aria-pressed="@(active ? "true" : "false")"
                            @onmousedown:preventDefault
                            @onclick="() => RunAsync(item.Command)">@item.Text</button>
                }
            </div>
        }
        <div class="wn-toolbar-group">
            <button type="button" class="wn-tool @(_active.Contains("link") ? "is-active" : null)" title="@T["Link"] (@Modifier+@T["click a link to open it"])"
                    aria-pressed="@(_active.Contains("link") ? "true" : "false")" @onmousedown:preventDefault @onclick="PromptLinkAsync">@T["Link"]</button>
            @if (_active.Contains("link"))
            {
                <button type="button" class="wn-tool" title="@T["Remove link"]" @onmousedown:preventDefault @onclick="@(() => RunAsync("unlink"))">@T["Unlink"]</button>
            }
            <button type="button" class="wn-tool" title="@T["Link to another note"]" @onmousedown:preventDefault @onclick="() => _notePicker = true">@T["Note link"]</button>
            <button type="button" class="wn-tool" title="@T["Insert image from a file"]" @onmousedown:preventDefault @onclick="PickImageAsync">@T["Image"]</button>
            <button type="button" class="wn-tool" title="@T["Attach a file to this note"]" @onmousedown:preventDefault @onclick="AttachFileAsync">@T["Attach"]</button>
            <button type="button" class="wn-tool" title="@T["Earlier versions of this note"]" @onmousedown:preventDefault @onclick="OpenHistoryAsync">@T["History"]</button>
            <button type="button" class="wn-tool" title="@T["Insert table"]" @onmousedown:preventDefault @onclick="@(() => RunAsync("insertTable"))">@T["Table"]</button>
        </div>
        <div class="wn-toolbar-group">
            <button type="button" class="wn-tool @(_active.Contains("highlight") ? "is-active" : null)" title="@T["Highlight (marker)"]" aria-pressed="@(_active.Contains("highlight") ? "true" : "false")"
                    @onmousedown:preventDefault @onclick="@(() => RunAsync("highlight"))"><mark>ab</mark></button>
            <select class="wn-select wn-tool-select @(_active.Contains("callout") ? "is-active" : null)" aria-label="@T["Callout box"]" title="@T["Callout box: a box that stands out; choose it again to remove it"]"
                    @key="_calloutKey" value="" @onchange="OnCalloutChosenAsync">
                <option value="">@(_active.Contains("callout") ? T["Callout ✓"] : T["Callout…"])</option>
                <option value="calloutInfo">@T["Info"]</option>
                <option value="calloutTip">@T["Tip"]</option>
                <option value="calloutWarning">@T["Warning"]</option>
                <option value="calloutDanger">@T["Danger"]</option>
            </select>
            <button type="button" class="wn-tool @(_find ? "is-active" : null)" title="@T["Find and replace"] (@Modifier+F)" aria-pressed="@(_find ? "true" : "false")"
                    @onmousedown:preventDefault @onclick="OpenFindAsync">@T["Find"]</button>
        </div>
        @if (_active.Contains("codeBlock"))
        {
            <div class="wn-toolbar-group" role="group" aria-label="@T["Code block"]">
                <select class="wn-select wn-tool-select" aria-label="@T["Language"]" title="@T["Language of the code block"]" value="@_codeLanguage" @onchange="e => SetCodeLanguageAsync((string)e.Value!)">
                    <option value="">@T["Plain"]</option>
                    @foreach (var language in CodeLanguages)
                    {
                        <option value="@language.Id">@language.Name</option>
                    }
                </select>
            </div>
        }
        @if (_active.Contains("table"))
        {
            <div class="wn-toolbar-group" role="group" aria-label="@T["Table"]">
                @foreach (var item in TableTools)
                {
                    <button type="button" class="wn-tool" title="@T[item.Label]" aria-label="@T[item.Label]"
                            @onmousedown:preventDefault @onclick="() => RunAsync(item.Command)">@T[item.Text]</button>
                }
            </div>
        }
    </div>

    @if (_find)
    {
        <div class="wn-findbar" role="search" aria-label="@T["Find in note"]">
            <input @ref="_findInput" type="text" class="wn-input wn-find-input" placeholder="@T["Find"]" aria-label="@T["Find"]" value="@_findText" autocomplete="off"
                   @oninput="e => FindAsync(e.Value?.ToString() ?? string.Empty)" @onkeydown="OnFindKeyDown" />
            <span class="wn-find-count" aria-live="polite">@(_findCount == 0 ? (_findText.Length == 0 ? "" : T["No matches"]) : T["{0} of {1}", _findCurrent, _findCount])</span>
            <button type="button" class="wn-tool" title="@T["Previous match"] (Shift+Enter)" aria-label="@T["Previous match"]" @onclick="() => FindNextAsync(true)">↑</button>
            <button type="button" class="wn-tool" title="@T["Next match"] (Enter)" aria-label="@T["Next match"]" @onclick="() => FindNextAsync(false)">↓</button>
            <label class="wn-find-option"><input type="checkbox" checked="@_findCase" @onchange="e => SetFindCaseAsync((bool)e.Value!)" /> @T["Match case"]</label>
            <input type="text" class="wn-input wn-find-input" placeholder="@T["Replace with"]" aria-label="@T["Replace with"]" value="@_replaceText" autocomplete="off"
                   @oninput="e => _replaceText = e.Value?.ToString() ?? string.Empty" @onkeydown="OnReplaceKeyDown" />
            <button type="button" class="wn-tool" title="@T["Replace this match"]" @onclick="ReplaceAsync" disabled="@(_findCount == 0)">@T["Replace"]</button>
            <button type="button" class="wn-tool" title="@T["Replace every match"]" @onclick="ReplaceAllAsync" disabled="@(_findCount == 0)">@T["All"]</button>
            <button type="button" class="wn-tool" title="@T["Close"] (Esc)" aria-label="@T["Close find"]" @onclick="CloseFindAsync">✕</button>
        </div>
    }

    <div class="wn-editor-surface" @ref="_surface">
    </div>
    <AttachmentsPanel NoteId="Note.Id" Content="@_content" Version="_attachmentsVersion" OnProblem="OnProblem" />
    <NoteConnections NoteId="Note.Id" Version="ConnectionsVersion" OnOpen="OnOpenNote" />
</section>

@if (_history)
{
    <HistoryDialog NoteId="Note.Id" OnRestored="RestoredAsync" OnCancel="() => _history = false" />
}

@if (_notePicker)
{
    <NotePickerDialog ExcludeId="Note.Id" OnPick="LinkToNoteAsync" OnCancel="CloseNotePicker" />
}

@if (_linkPrompt)
{
    <PromptDialog Title="@T["Link"]" Label="@T["Web address"]" InitialValue="@_linkAddress" ConfirmText="@T["Apply"]" MaxLength="2000"
                  Error="@_linkError" OnConfirm="ApplyLinkAsync" OnCancel="CloseLinkPrompt" />
}

@code {
    private static readonly ToolbarItem[][] ToolbarGroups =
    [
        [new("bold", "B", "Bold"), new("italic", "I", "Italic"), new("underline", "U", "Underline"), new("strike", "S", "Strikethrough"), new("code", "<>", "Inline code")],
        [new("heading1", "H1", "Heading 1"), new("heading2", "H2", "Heading 2"), new("heading3", "H3", "Heading 3")],
        [new("bulletList", "•", "Bulleted list"), new("orderedList", "1.", "Numbered list"), new("taskList", "☑", "Checklist")],
        [new("blockquote", "“ ”", "Block quote"), new("codeBlock", "{ }", "Code block"), new("horizontalRule", "—", "Horizontal rule")],
    ];

    private static readonly ToolbarItem[] TableTools =
    [
        new("addRow", "+ Row", "Add a row below"),
        new("addColumn", "+ Column", "Add a column to the right"),
        new("deleteRow", "− Row", "Delete this row"),
        new("deleteColumn", "− Column", "Delete this column"),
        new("mergeCells", "Merge", "Merge the selected cells"),
        new("splitCell", "Split", "Split the cell"),
        new("toggleHeaderRow", "Header", "Turn the first row into a header or back"),
        new("deleteTable", "Delete table", "Delete the whole table"),
    ];

    /// <summary>Languages the code block can colour (the "common" set of highlight.js).</summary>
    private static readonly (string Id, string Name)[] CodeLanguages =
    [
        ("bash", "Bash"), ("c", "C"), ("cpp", "C++"), ("csharp", "C#"), ("css", "CSS"), ("diff", "Diff"), ("go", "Go"),
        ("graphql", "GraphQL"), ("ini", "INI / TOML"), ("java", "Java"), ("javascript", "JavaScript"), ("json", "JSON"),
        ("kotlin", "Kotlin"), ("less", "Less"), ("lua", "Lua"), ("makefile", "Makefile"), ("markdown", "Markdown"),
        ("objectivec", "Objective-C"), ("perl", "Perl"), ("php", "PHP"), ("plaintext", "Plain text"), ("python", "Python"),
        ("r", "R"), ("ruby", "Ruby"), ("rust", "Rust"), ("scss", "SCSS"), ("shell", "Shell session"), ("sql", "SQL"),
        ("swift", "Swift"), ("typescript", "TypeScript"), ("vbnet", "VB.NET"), ("wasm", "WebAssembly"), ("xml", "HTML / XML"), ("yaml", "YAML"),
    ];

    private bool _find;
    private string _findText = string.Empty;
    private string _replaceText = string.Empty;
    private bool _findCase;
    private int _findCount;
    private int _findCurrent;
    private ElementReference _findInput;
    private string _codeLanguage = string.Empty;

    private int _calloutKey;

    private async Task OnCalloutChosenAsync(ChangeEventArgs args)
    {
        // The box re-renders so it shows the placeholder again, whatever was picked.
        _calloutKey++;
        if (args.Value?.ToString() is { Length: > 0 } command)
        {
            await RunAsync(command);
        }
    }

    private sealed record SearchState(int Count, int Current);

    /// <summary>Shows the find bar (Ctrl/⌘+F) and puts the cursor in it.</summary>
    public async Task OpenFindAsync()
    {
        _find = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            await _findInput.FocusAsync();
        }
        catch (JSException)
        {
            // The bar is not rendered yet; the next key press lands in it anyway.
        }
    }

    private async Task FindAsync(string text)
    {
        _findText = text;
        await ApplySearchAsync(await EditorAsync<SearchState>("search", _findText, _findCase));
    }

    private async Task SetFindCaseAsync(bool caseSensitive)
    {
        _findCase = caseSensitive;
        await ApplySearchAsync(await EditorAsync<SearchState>("search", _findText, _findCase));
    }

    private async Task FindNextAsync(bool backwards) => await ApplySearchAsync(await EditorAsync<SearchState>("findNext", backwards));

    private async Task ReplaceAsync() => await ApplySearchAsync(await EditorAsync<SearchState>("replace", _replaceText));

    private async Task ReplaceAllAsync() => await ApplySearchAsync(await EditorAsync<SearchState>("replaceAll", _replaceText));

    private Task ApplySearchAsync(SearchState? state)
    {
        _findCount = state?.Count ?? 0;
        _findCurrent = state?.Current ?? 0;
        return Task.CompletedTask;
    }

    private async Task OnFindKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Enter":
                await FindNextAsync(args.ShiftKey);
                break;
            case "Escape":
                await CloseFindAsync();
                break;
        }
    }

    private async Task OnReplaceKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Enter":
                await ReplaceAsync();
                break;
            case "Escape":
                await CloseFindAsync();
                break;
        }
    }

    private async Task CloseFindAsync()
    {
        _find = false;
        _findCount = 0;
        _findCurrent = 0;
        await EditorAsync("clearSearch");
        await EditorAsync("focus");
    }

    private async Task SetCodeLanguageAsync(string language)
    {
        _codeLanguage = language;
        await EditorAsync("setCodeLanguage", language);
    }

    /// <summary>Called by the editor when "[[" is typed: pick a note to link to.</summary>
    [JSInvokable]
    public void OnNoteLinkTrigger()
    {
        _notePicker = true;
        StateHasChanged();
    }

    private static string Modifier => OperatingSystem.IsMacOS() ? "⌘" : "Ctrl";

    private int _attachmentsVersion;
    private bool _history;
    private bool _notePicker;
    private bool _linkPrompt;
    private string _linkAddress = string.Empty;
    private string? _linkError;

    private ElementReference _surface;
    private ElementReference _titleInput;
    private IJSObjectReference? _module;
    private IJSObjectReference? _editor;
    private DotNetObjectReference<NoteEditor>? _self;
    private HashSet<string> _active = [];
    private Guid? _loadedNoteId;
    private string _title = string.Empty;
    private string _content = string.Empty;
    private bool _contentNeedsPush;
    private bool _focusTitle;

    /// <summary>The note being edited. Changing its <see cref="NoteDetail.Id"/> loads the new note into the editor.</summary>
    [Parameter, EditorRequired] public NoteDetail Note { get; set; } = default!;

    /// <summary>Raised with the latest title and body whenever the user changes either.</summary>
    [Parameter] public EventCallback<NoteEdit> OnEdited { get; set; }

    /// <summary>Something the user tried did not work; the text says what and why.</summary>
    [Parameter] public EventCallback<string> OnProblem { get; set; }

    /// <summary>An earlier version was restored; the note now has this title and text.</summary>
    [Parameter] public EventCallback<NoteDetail> OnRestored { get; set; }

    /// <summary>A link to another note was followed; the owner opens that note.</summary>
    [Parameter] public EventCallback<Guid> OnOpenNote { get; set; }

    /// <summary>Changes whenever the note was saved or its tags changed, so the connected notes are re-read.</summary>
    [Parameter] public int ConnectionsVersion { get; set; }

    [Parameter] public EventCallback OnToggleFavorite { get; set; }
    [Parameter] public EventCallback OnTogglePinned { get; set; }

    /// <summary>The note's tags were changed in the editor.</summary>
    [Parameter] public EventCallback OnTagsChanged { get; set; }

    /// <summary>The user asked to move this note to the trash.</summary>
    [Parameter] public EventCallback OnDelete { get; set; }

    /// <summary>Puts the cursor in the title of the next note that is loaded.</summary>
    public void FocusTitleOnNextLoad() => _focusTitle = true;

    /// <summary>Shows a note's current title and text, for example after an earlier version was restored.</summary>
    public async Task ReloadAsync(NoteDetail note)
    {
        _loadedNoteId = note.Id;
        _title = note.Title == Domain.Node.DefaultNoteName ? string.Empty : note.Title;
        _content = note.Content;
        await EditorAsync("setContent", _content);
        StateHasChanged();
    }

    /// <summary>Sends any keystrokes the editor is still holding back to <see cref="OnEdited"/>.</summary>
    public async Task FlushAsync()
    {
        if (_editor is not null)
        {
            await EditorAsync("flush");
        }
    }

    protected override void OnParametersSet()
    {
        if (Note.Id == _loadedNoteId)
        {
            return;
        }

        _loadedNoteId = Note.Id;
        _title = Note.Title == Domain.Node.DefaultNoteName ? string.Empty : Note.Title;
        _content = Note.Content;
        _contentNeedsPush = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", UiAssets.Editor);
            _editor = await _module.InvokeAsync<IJSObjectReference>("create", _surface, _self, _content);
            _contentNeedsPush = false;
            Settings.Changed += OnSettingsChanged;
            await EditorAsync("setSpellCheck", Settings.Current.SpellCheck);
        }
        else if (_contentNeedsPush && _editor is not null)
        {
            _contentNeedsPush = false;
            await EditorAsync("setContent", _content);
        }

        if (_focusTitle && _editor is not null)
        {
            _focusTitle = false;
            await _titleInput.FocusAsync();
        }
    }

    [JSInvokable]
    public Task OnEditorChanged(string html)
    {
        _content = html;
        return OnEdited.InvokeAsync(new NoteEdit(Note.Id, _title, _content));
    }

    [JSInvokable]
    public void OnEditorSelectionChanged(string[] active)
    {
        _active = [.. active];
        if (_active.Contains("codeBlock"))
        {
            _ = InvokeAsync(async () =>
            {
                _codeLanguage = await EditorAsync<string>("getCodeLanguage") ?? string.Empty;
                StateHasChanged();
            });
        }

        StateHasChanged();
    }

    /// <summary>
    /// Called by the editor for an image that was pasted or dropped. Stores it as an attachment of
    /// this note and returns the address to show it by, or <c>null</c> when it was refused.
    /// </summary>
    [JSInvokable]
    public async Task<string?> OnImageFile(IJSStreamReference file, string name, string contentType)
    {
        try
        {
            await using var content = await file.OpenReadStreamAsync(Attachment.MaxSizeBytes);
            return await AttachImageAsync(name, contentType, content);
        }
        catch (Exception ex) when (ex is not DomainException)
        {
            Logger.LogError(ex, "A pasted or dropped image could not be read");
            await OnProblem.InvokeAsync(T["The image could not be added."]);
            return null;
        }
        finally
        {
            await file.DisposeAsync();
        }
    }

    /// <summary>Called by the editor when a link is clicked with Ctrl or Cmd held.</summary>
    [JSInvokable]
    public async Task OnOpenLink(string? address)
    {
        if (NoteContentRules.NoteLinkTarget(address) is { } noteId)
        {
            await OnOpenNote.InvokeAsync(noteId);
        }
        else if (NoteContentRules.IsWebLink(address))
        {
            Shell.OpenWebPage(new Uri(address!));
        }
    }

    private async Task LinkToNoteAsync(NotePickerDialog.Choice choice)
    {
        _notePicker = false;
        if (_editor is not null)
        {
            await EditorAsync("setNoteLink", NoteContentRules.NoteLinkAddress(choice.Id), choice.Title);
        }
    }

    private async Task CloseNotePicker()
    {
        _notePicker = false;
        if (_editor is not null)
        {
            await EditorAsync("focus");
        }
    }

    private async Task PickImageAsync()
    {
        var path = await Shell.PickFileAsync(T["Insert image"], T["Images"], [.. NoteContentRules.ImageContentTypes.Keys]);
        if (path is null || _editor is null)
        {
            return;
        }

        try
        {
            await using var content = File.OpenRead(path);
            var source = await AttachImageAsync(Path.GetFileName(path), NoteContentRules.ImageContentType(path), content);
            if (source is not null)
            {
                await EditorAsync("insertImage", source, Path.GetFileNameWithoutExtension(path));
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Logger.LogError(ex, "The chosen image could not be read");
            await OnProblem.InvokeAsync(T["That file could not be read."]);
        }
    }

    private async Task<string?> AttachImageAsync(string? name, string? contentType, Stream content)
    {
        var fileName = NoteContentRules.ImageFileName(name, contentType);
        if (fileName is null)
        {
            await OnProblem.InvokeAsync(T["Only PNG, JPEG, GIF and WebP images can be placed in a note."]);
            return null;
        }

        try
        {
            var attachment = await Attachments.AddAsync(Note.Id, fileName, contentType, content);
            _attachmentsVersion++;
            StateHasChanged();
            return NoteContentRules.AttachmentSource(attachment.StoredFileName);
        }
        catch (DomainException ex)
        {
            await OnProblem.InvokeAsync(ex.Message);
            return null;
        }
    }

    /// <summary>Called by the editor for a file that is not an image, dropped on the note: it is attached, not placed in the text.</summary>
    [JSInvokable]
    public async Task OnFileDrop(IJSStreamReference file, string name, string contentType)
    {
        try
        {
            await using var content = await file.OpenReadStreamAsync(Attachment.MaxSizeBytes);
            await AttachAsync(name, contentType, content);
        }
        catch (Exception ex) when (ex is not DomainException)
        {
            Logger.LogError(ex, "A dropped file could not be read");
            await OnProblem.InvokeAsync(T["The file could not be attached."]);
        }
        finally
        {
            await file.DisposeAsync();
        }
    }

    private async Task AttachFileAsync()
    {
        var path = await Shell.PickFileAsync(T["Attach a file"], T["All files"], []);
        if (path is null)
        {
            return;
        }

        try
        {
            await using var content = File.OpenRead(path);
            await AttachAsync(Path.GetFileName(path), NoteContentRules.ImageContentType(path), content);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Logger.LogError(ex, "The chosen file could not be read");
            await OnProblem.InvokeAsync(T["That file could not be read."]);
        }
    }

    private async Task AttachAsync(string name, string? contentType, Stream content)
    {
        try
        {
            await Attachments.AddAsync(Note.Id, name, contentType, content);
            _attachmentsVersion++;
        }
        catch (DomainException ex)
        {
            await OnProblem.InvokeAsync(ex.Message);
        }

        // Reached from a JavaScript call as well as from a click; only the click re-renders by itself.
        StateHasChanged();
    }

    private async Task OpenHistoryAsync()
    {
        // Whatever is typed is saved first, so the version kept before restoring is the real current text.
        await FlushAsync();
        _history = true;
    }

    private async Task RestoredAsync(NoteDetail restored)
    {
        _history = false;
        await ReloadAsync(restored);
        await OnRestored.InvokeAsync(restored);
    }

    private async Task PromptLinkAsync()
    {
        if (_editor is null)
        {
            return;
        }

        _linkAddress = await _editor.InvokeAsync<string>("getLinkAddress");
        _linkError = null;
        _linkPrompt = true;
    }

    private async Task ApplyLinkAsync(string address)
    {
        // "example.com" is what people type; the address stored is always a full web address.
        var full = address.Contains("://", StringComparison.Ordinal) ? address : "https://" + address;
        if (!NoteContentRules.IsWebLink(full) || full.Any(char.IsWhiteSpace))
        {
            _linkError = T["Enter a web address, such as https://www.cloudworrior.com"];
            return;
        }

        _linkPrompt = false;
        if (_editor is not null)
        {
            await EditorAsync("setLink", full);
        }
    }

    private async Task CloseLinkPrompt()
    {
        _linkPrompt = false;
        if (_editor is not null)
        {
            await EditorAsync("focus");
        }
    }

    private Task OnTitleInput(ChangeEventArgs args)
    {
        _title = args.Value?.ToString() ?? string.Empty;
        return OnEdited.InvokeAsync(new NoteEdit(Note.Id, _title, _content));
    }

    /// <summary>Enter in the title continues in the body, as it would on paper.</summary>
    private async Task OnTitleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.IsComposing && _editor is not null)
        {
            await EditorAsync("focus");
        }
    }

        private async Task RunAsync(string command)
    {
        if (_editor is not null)
        {
            await EditorAsync("run", command);
        }
    }

    /// <summary>
    /// Calls a function of the editor module. A failure there must not take the whole page down,
    /// so it is logged and shown as a message instead.
    /// </summary>
    private async Task<TResult?> EditorAsync<TResult>(string function, params object?[] args)
    {
        if (_editor is null)
        {
            return default;
        }

        try
        {
            return await _editor.InvokeAsync<TResult>(function, args);
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "The editor could not run {Function}", function);
            await OnProblem.InvokeAsync(T["The editor did not respond. Reopen the note and try again."]);
            return default;
        }
    }

    private async Task EditorAsync(string function, params object?[] args)
    {
        if (_editor is null)
        {
            return;
        }

        try
        {
            await _editor.InvokeVoidAsync(function, args);
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "The editor function {Function} failed", function);
            await OnProblem.InvokeAsync(T["The editor did not respond to that. If it keeps happening, restart WorriorVex."]);
        }
    }

    private void OnSettingsChanged(WorriorVex.Application.Settings.AppSettings settings) => _ = InvokeAsync(async () =>
    {
        await EditorAsync("setSpellCheck", settings.SpellCheck);
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Settings.Changed -= OnSettingsChanged;
        try
        {
            if (_editor is not null)
            {
                await _editor.InvokeVoidAsync("destroy");
                await _editor.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        _self?.Dispose();
    }

    private sealed record ToolbarItem(string Command, string Text, string Label);
}
