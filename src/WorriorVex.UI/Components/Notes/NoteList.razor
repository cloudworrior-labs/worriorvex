<section class="wn-notelist" aria-label="Notes">
    <header class="wn-pane-header">
        <h2>@Heading</h2>
        <span class="wn-count">@Notes.Count</span>
    </header>
    @if (ShowActions && ChildContent is not null)
    {
        <div class="wn-pane-actions">@ChildContent</div>
    }
    @if (Notes.Count == 0 && EmptyMessage is not null)
    {
        <div class="wn-empty"><p>@EmptyMessage</p></div>
    }
    else if (Notes.Count == 0)
    {
        <div class="wn-empty">
            <p>Nothing here yet.</p>
            <button type="button" class="wn-button wn-button-primary" @onclick="OnCreate">@(FirstEver ? "Create your first note" : "New note")</button>
        </div>
    }
    else
    {
        <ul class="wn-notelist-items" aria-label="@Heading">
            @foreach (var note in Notes)
            {
                var selected = note.Id == SelectedId;
                <li @key="note.Id">
                    <button type="button" class="wn-noteitem @(selected ? "is-selected" : null)" aria-current="@(selected ? "true" : null)"
                            draggable="true" @ondragstart="() => OnDragStart.InvokeAsync(note.Id)" @ondragend="OnDragEnd"
                            @oncontextmenu:preventDefault @oncontextmenu="e => OnContextMenu.InvokeAsync((note, e))"
                            @onclick="() => OnSelect.InvokeAsync(note.Id)">
                        <span class="wn-noteitem-title">
                            @if (note.IsPinned)
                            {
                                <span class="wn-noteitem-flag" title="Pinned" aria-label="Pinned">⌖</span>
                            }
                            @if (note.IsFavorite)
                            {
                                <span class="wn-noteitem-flag" title="Favorite" aria-label="Favorite">★</span>
                            }
                            @note.Title
                        </span>
                        <span class="wn-noteitem-meta">
                            @if (NotebookNames is not null && NotebookNames.TryGetValue(note.NotebookId, out var notebook))
                            {
                                <text>@notebook · </text>
                            }
                            @(ShowOpened && note.LastOpenedAt is { } opened ? Format("Opened", opened) : Format("Updated", note.UpdatedAt))
                        </span>
                    </button>
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Heading { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<NoteSummary> Notes { get; set; } = [];
    [Parameter] public Guid? SelectedId { get; set; }

    /// <summary>When given, each note also says which notebook it is in (for lists that span notebooks).</summary>
    [Parameter] public IReadOnlyDictionary<Guid, string>? NotebookNames { get; set; }

    [Parameter] public bool FirstEver { get; set; }

    /// <summary>Shown instead of the "new note" invitation when the list is empty because of what it filters on.</summary>
    [Parameter] public string? EmptyMessage { get; set; }
    [Parameter] public EventCallback<Guid> OnSelect { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback<(NoteSummary Note, MouseEventArgs Mouse)> OnContextMenu { get; set; }
    [Parameter] public EventCallback<Guid> OnDragStart { get; set; }
    [Parameter] public EventCallback OnDragEnd { get; set; }

    /// <summary>What the meta line says about the time: "Updated" or, for the Recent list, "Opened".</summary>
    [Parameter] public bool ShowOpened { get; set; }

    [Parameter] public bool ShowActions { get; set; }

    /// <summary>Actions for the container the list shows, placed under the heading.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static string Format(string what, DateTimeOffset at)
    {
        var local = at.ToLocalTime();
        return local.Date == DateTimeOffset.Now.Date ? $"{what} {local:t}" : $"{what} {local:d}";
    }
}
