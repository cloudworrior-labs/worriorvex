<ul class="wn-nav-list wn-tree" style="--wn-level: @Level">
    @foreach (var folder in Children[(NotebookId, ParentId)])
    {
        var selection = new NavSelection.Folder(folder.NotebookId, folder.Id);
        var selected = selection == Selection;
        var hasFolders = Children.Contains((NotebookId, folder.Id));
        var expanded = !Collapsed.Contains(folder.Id);
        <li @key="folder.Id">
            <div class="wn-navrow">
                @if (hasFolders)
                {
                    <button type="button" class="wn-twisty" aria-expanded="@(expanded ? "true" : "false")"
                            aria-label="@(expanded ? "Collapse" : "Expand") @folder.Name"
                            @onclick="() => OnToggle.InvokeAsync(folder.Id)">@(expanded ? "▾" : "▸")</button>
                }
                else
                {
                    <span class="wn-twisty" aria-hidden="true"></span>
                }
                <button type="button" class="wn-navitem @(selected ? "is-selected" : null) @(DropTarget == folder.Id ? "is-droptarget" : null)"
                        aria-current="@(selected ? "true" : null)" draggable="true" title="@folder.Name"
                        @onclick="() => OnSelect.InvokeAsync(selection)"
                        @oncontextmenu:preventDefault @oncontextmenu="e => OnContextMenu.InvokeAsync((selection, e))"
                        @ondragstart="() => OnDragStart.InvokeAsync(folder.Id)" @ondragend="OnDragEnd"
                        @ondragenter="() => OnDragEnter.InvokeAsync(folder.Id)" @ondragover:preventDefault
                        @ondrop:preventDefault @ondrop="() => OnDrop.InvokeAsync(selection)">@folder.Name</button>
            </div>
            @if (hasFolders && expanded)
            {
                <FolderTree NotebookId="NotebookId" ParentId="folder.Id" Children="Children" Collapsed="Collapsed" DropTarget="DropTarget"
                            Selection="Selection" OnSelect="OnSelect" OnToggle="OnToggle" OnContextMenu="OnContextMenu"
                            OnDragStart="OnDragStart" OnDragEnd="OnDragEnd" OnDragEnter="OnDragEnter" OnDrop="OnDrop" Level="Level + 1" />
            }
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public Guid NotebookId { get; set; }
    [Parameter] public Guid? ParentId { get; set; }
    [Parameter, EditorRequired] public ILookup<(Guid NotebookId, Guid? ParentId), FolderSummary> Children { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlySet<Guid> Collapsed { get; set; } = default!;
    [Parameter] public Guid? DropTarget { get; set; }
    [Parameter, EditorRequired] public NavSelection Selection { get; set; } = default!;
    [Parameter] public EventCallback<NavSelection> OnSelect { get; set; }
    [Parameter] public EventCallback<Guid> OnToggle { get; set; }
    [Parameter] public EventCallback<(NavSelection Target, MouseEventArgs Mouse)> OnContextMenu { get; set; }
    [Parameter] public EventCallback<Guid> OnDragStart { get; set; }
    [Parameter] public EventCallback OnDragEnd { get; set; }
    [Parameter] public EventCallback<Guid> OnDragEnter { get; set; }
    [Parameter] public EventCallback<NavSelection> OnDrop { get; set; }
    [Parameter] public int Level { get; set; } = 1;
}
