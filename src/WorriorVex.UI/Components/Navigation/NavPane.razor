<nav class="wn-nav" aria-label="Navigation">
    <ul class="wn-nav-list">
        @if (Inbox is not null)
        {
            <li>
                <button type="button" class="wn-navitem @SelectedClass(new NavSelection.Notebook(Inbox.Id))"
                        aria-current="@Current(new NavSelection.Notebook(Inbox.Id))"
                        @onclick="() => OnSelect.InvokeAsync(new NavSelection.Notebook(Inbox.Id))">Inbox</button>
            </li>
        }
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.AllNotes())"
                    aria-current="@Current(new NavSelection.AllNotes())"
                    @onclick="() => OnSelect.InvokeAsync(new NavSelection.AllNotes())">All Notes</button>
        </li>
    </ul>

    <div class="wn-nav-section">
        <h2 id="wn-notebooks-heading">Notebooks</h2>
        <button type="button" class="wn-iconbutton" title="New notebook" aria-label="New notebook" @onclick="OnNewNotebook">+</button>
    </div>

    @if (UserNotebooks.Count == 0)
    {
        <p class="wn-nav-hint">No notebooks yet.</p>
    }
    else
    {
        <ul class="wn-nav-list" aria-labelledby="wn-notebooks-heading">
            @foreach (var notebook in UserNotebooks)
            {
                var selection = new NavSelection.Notebook(notebook.Id);
                var hasFolders = _children.Contains((notebook.Id, null));
                var expanded = !_collapsed.Contains(notebook.Id);
                <li @key="notebook.Id">
                    <div class="wn-navrow">
                        @if (hasFolders)
                        {
                            <button type="button" class="wn-twisty" aria-expanded="@(expanded ? "true" : "false")"
                                    aria-label="@(expanded ? "Collapse" : "Expand") @notebook.Name"
                                    @onclick="() => Toggle(notebook.Id)">@(expanded ? "▾" : "▸")</button>
                        }
                        else
                        {
                            <span class="wn-twisty" aria-hidden="true"></span>
                        }
                        <button type="button" class="wn-navitem @SelectedClass(selection)" aria-current="@Current(selection)"
                                @onclick="() => OnSelect.InvokeAsync(selection)">@notebook.Name</button>
                    </div>
                    @if (hasFolders && expanded)
                    {
                        <FolderTree NotebookId="notebook.Id" ParentId="null" Children="_children" Collapsed="_collapsed"
                                    Selection="Selection" OnSelect="OnSelect" OnToggle="Toggle" Level="1" />
                    }
                </li>
            }
        </ul>
    }

    <ul class="wn-nav-list wn-nav-bottom">
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.Trash())"
                    aria-current="@Current(new NavSelection.Trash())"
                    @onclick="() => OnSelect.InvokeAsync(new NavSelection.Trash())">Trash</button>
        </li>
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.Documentation())"
                    aria-current="@Current(new NavSelection.Documentation())"
                    @onclick="() => OnSelect.InvokeAsync(new NavSelection.Documentation())">Documentation</button>
        </li>
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.About())"
                    aria-current="@Current(new NavSelection.About())"
                    @onclick="() => OnSelect.InvokeAsync(new NavSelection.About())">About</button>
        </li>
    </ul>
</nav>

@code {
    private readonly HashSet<Guid> _collapsed = [];
    private ILookup<(Guid NotebookId, Guid? ParentId), FolderSummary> _children = Array.Empty<FolderSummary>().ToLookup(f => (f.NotebookId, f.ParentId));

    [Parameter, EditorRequired] public IReadOnlyList<NotebookSummary> Notebooks { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<FolderSummary> Folders { get; set; } = [];
    [Parameter, EditorRequired] public NavSelection Selection { get; set; } = new NavSelection.AllNotes();
    [Parameter] public EventCallback<NavSelection> OnSelect { get; set; }
    [Parameter] public EventCallback OnNewNotebook { get; set; }

    private NotebookSummary? Inbox => Notebooks.FirstOrDefault(n => n.IsInbox);
    private List<NotebookSummary> UserNotebooks => [.. Notebooks.Where(n => !n.IsInbox)];

    protected override void OnParametersSet()
    {
        _children = Folders.ToLookup(f => (f.NotebookId, f.ParentId));
    }

    private void Toggle(Guid id)
    {
        if (!_collapsed.Remove(id))
        {
            _collapsed.Add(id);
        }
    }

    private string? SelectedClass(NavSelection selection) => selection == Selection ? "is-selected" : null;
    private string? Current(NavSelection selection) => selection == Selection ? "true" : null;
}
