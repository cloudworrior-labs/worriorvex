<label class="wn-move-option @(IsChosen ? "is-chosen" : null)" style="--wn-level: @Level">
    <input type="radio" name="wn-move-destination" disabled="@Disabled" checked="@IsChosen"
           @onchange="() => OnChoose.InvokeAsync((NotebookId, ParentId))" />
    <span>@Label</span>
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public Guid NotebookId { get; set; }
    [Parameter] public Guid? ParentId { get; set; }
    [Parameter] public int Level { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public (Guid NotebookId, Guid? ParentId)? Chosen { get; set; }
    [Parameter] public EventCallback<(Guid NotebookId, Guid? ParentId)> OnChoose { get; set; }

    private bool IsChosen => Chosen is { } chosen && chosen.NotebookId == NotebookId && chosen.ParentId == ParentId;
}
