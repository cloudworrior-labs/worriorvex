@inject Translator T
<div class="wn-overlay" @onkeydown="OnKeyDown">
    <form class="wn-dialog" role="dialog" aria-modal="true" aria-labelledby="wn-prompt-title" @onsubmit="SubmitAsync">
        <h2 id="wn-prompt-title">@Title</h2>
        <label for="wn-prompt-input">@Label</label>
        <input id="wn-prompt-input" @ref="_input" type="text" class="wn-input" maxlength="@MaxLength" autocomplete="off"
               @bind="_value" @bind:event="oninput" aria-describedby="@(Error is null ? null : "wn-prompt-error")" />
        @if (Error is not null)
        {
            <p id="wn-prompt-error" class="wn-dialog-error" role="alert">@Error</p>
        }
        <div class="wn-dialog-actions">
            <button type="button" class="wn-button" @onclick="OnCancel">@T["Cancel"]</button>
            @* Never disabled: a disabled default button would swallow Enter typed right after the name. *@
            <button type="submit" class="wn-button wn-button-primary">@ConfirmText</button>
        </div>
    </form>
</div>

@code {
    private ElementReference _input;
    private string _value = string.Empty;
    private bool _busy;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string InitialValue { get; set; } = string.Empty;
    [Parameter] public string ConfirmText { get; set; } = "OK";
    [Parameter] public int MaxLength { get; set; } = 200;

    /// <summary>Why the last attempt was refused, shown inside the dialog so the name can be corrected.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public EventCallback<string> OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    protected override void OnInitialized() => _value = InitialValue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _input.FocusAsync();
        }
    }

    private async Task SubmitAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_value))
        {
            return;
        }

        _busy = true;
        try
        {
            await OnConfirm.InvokeAsync(_value.Trim());
        }
        finally
        {
            _busy = false;
        }
    }

    private Task OnKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? OnCancel.InvokeAsync() : Task.CompletedTask;
}
