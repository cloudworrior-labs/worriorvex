@using WorriorVex.Application.Export

<div class="wn-overlay" @onkeydown="OnKeyDown">
    <div class="wn-dialog" role="dialog" aria-modal="true" aria-labelledby="wn-export-title">
        <h2 id="wn-export-title">Export "@Title"</h2>
        <div class="wn-move-tree" role="radiogroup" aria-label="Format">
            <label class="wn-move-option @(_format == ExportFormat.Html ? "is-chosen" : null)"><input type="radio" name="wn-export-note" checked="@(_format == ExportFormat.Html)" @onchange="() => _format = ExportFormat.Html" /><span>HTML — a self-contained web page, pictures embedded</span></label>
            <label class="wn-move-option @(_format == ExportFormat.Markdown ? "is-chosen" : null)"><input type="radio" name="wn-export-note" checked="@(_format == ExportFormat.Markdown)" @onchange="() => _format = ExportFormat.Markdown" /><span>Markdown — with a folder of pictures and files beside it</span></label>
            <label class="wn-move-option @(_format == ExportFormat.Json ? "is-chosen" : null)"><input type="radio" name="wn-export-note" checked="@(_format == ExportFormat.Json)" @onchange="() => _format = ExportFormat.Json" /><span>JSON — text, tags, links, attachments and history</span></label>
        </div>
        <div class="wn-dialog-actions">
            <button type="button" class="wn-button" @onclick="OnCancel">Cancel</button>
            <button type="button" class="wn-button wn-button-primary" @onclick="() => OnConfirm.InvokeAsync(_format)">Choose where to save…</button>
        </div>
    </div>
</div>

@code {
    private ExportFormat _format = ExportFormat.Html;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public EventCallback<ExportFormat> OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task OnKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? OnCancel.InvokeAsync() : Task.CompletedTask;
}
