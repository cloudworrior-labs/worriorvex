@implements IAsyncDisposable

<div class="wn-app">
    <header class="wn-topbar">
        <img class="wn-brand-mark" src="_content/WorriorVex.UI/img/worriorvex.svg" alt="" width="20" height="20" />
        <span class="wn-brand">WorriorVex</span>
        <SearchBox @ref="_searchBox" Text="@_searchText" OnChanged="SearchAsync" OnMove="MoveSearchMark" OnOpen="OpenMarkedResultAsync" OnClose="CloseSearchAsync" />
        <button type="button" class="wn-button wn-button-primary" @onclick="NewNoteAsync" title="New note (@_modifier+N)">+ New</button>
    </header>

    <NavPane Notebooks="_notebooks" Folders="_folders" Tags="_tags" Selection="_selection" Dragging="_dragging is not null"
             OnSelect="SelectAsync" OnNewNotebook="PromptNewNotebook" OnContextMenu="ShowNavMenu"
             OnDragStart="id => _dragging = (id, true)" OnDragEnd="() => _dragging = null" OnDrop="DropAsync" />

    @if (IsHelpPage)
    {
        @* Help pages use the width of the list and editor panes together. *@
    }
    else if (_selection is NavSelection.Search)
    {
        <SearchResults Query="@_searchText" Results="_searchResults" Searching="_searching" SelectedId="_current?.Id"
                       MarkedIndex="_searchMark" OnSelect="OpenAsync" />
    }
    else if (_selection is NavSelection.Trash)
    {
        <TrashList Items="_trash" SelectedId="_trashItem?.Id" OnSelect="item => _trashItem = item" OnEmpty="ConfirmEmptyTrash" />
    }
    else
    {
        <NoteList Heading="@Heading" Notes="_notes" SelectedId="_current?.Id" NotebookNames="@(ShowsManyPlaces ? NotebookNames : null)"
                  FirstEver="@(_selection is NavSelection.AllNotes)" EmptyMessage="@EmptyMessage" ShowOpened="@(_selection is NavSelection.Recent)"
                  ShowActions="CanHoldFolders" OnSelect="OpenAsync" OnCreate="NewNoteAsync" OnContextMenu="ShowNoteMenu"
                  OnDragStart="id => _dragging = (id, false)" OnDragEnd="() => _dragging = null">
            @if (CanHoldFolders)
            {
                <button type="button" class="wn-button wn-button-small" @onclick="PromptNewFolder">New folder</button>
            }
            @if (CanChangeContainer)
            {
                <button type="button" class="wn-button wn-button-small" @onclick="PromptRename">Rename</button>
                <button type="button" class="wn-button wn-button-small" @onclick="ConfirmDeleteContainer">Delete</button>
            }
        </NoteList>
    }

    <main class="wn-main @(IsHelpPage ? "wn-main-wide" : null)">
        @if (_error is not null)
        {
            <div class="wn-banner" role="alert">
                <span>@_error</span>
                <button type="button" class="wn-button" @onclick="() => _error = null">Dismiss</button>
            </div>
        }
        else if (_notice is not null)
        {
            <div class="wn-banner wn-banner-info" role="status">
                <span>@_notice</span>
                <button type="button" class="wn-button" @onclick="() => _notice = null">Dismiss</button>
            </div>
        }

        @if (_loading)
        {
            <div class="wn-empty"><p>Loading…</p></div>
        }
        else if (_selection is NavSelection.Documentation)
        {
            <DocumentationPage />
        }
        else if (_selection is NavSelection.About)
        {
            <AboutPage />
        }
        else if (_selection is NavSelection.Trash)
        {
            @if (_trashItem is null)
            {
                <div class="wn-empty"><p>@(_trash.Count == 0 ? "Deleted notes, folders and notebooks wait here until you restore or remove them." : "Select an item to restore it or delete it permanently.")</p></div>
            }
            else
            {
                <TrashDetail Item="_trashItem" OnRestore="RestoreAsync" OnDelete="ConfirmDeletePermanently" />
            }
        }
        else if (_current is null && _selection is NavSelection.Search)
        {
            <div class="wn-empty"><p>@(_searchResults.Count == 0 ? "Search looks through the titles, text and tags of all your notes." : "Select a note to open it, or press Enter for the first one.")</p></div>
        }
        else if (_current is null)
        {
            <div class="wn-empty">
                <p>No note selected.</p>
                <button type="button" class="wn-button wn-button-primary" @onclick="NewNoteAsync">New note</button>
            </div>
        }
        else
        {
            <NoteEditor @ref="_editor" Note="_current" OnEdited="OnEdited" OnDelete="DeleteCurrentNoteAsync" OnProblem="@(message => _error = message)"
                        OnToggleFavorite="ToggleFavoriteAsync" OnTogglePinned="TogglePinnedAsync" OnTagsChanged="LoadTagsAsync" />
        }
    </main>

    <footer class="wn-statusbar">
        <SaveStatus State="Autosaver.State" OnRetry="SaveNowAsync" />
    </footer>

    @if (_prompt is not null)
    {
        <PromptDialog @key="_prompt" Title="@_prompt.Title" Label="@_prompt.Label" InitialValue="@_prompt.InitialValue" ConfirmText="@_prompt.ConfirmText"
                      MaxLength="_prompt.MaxLength" Error="@_dialogError" OnConfirm="ConfirmPromptAsync" OnCancel="CloseDialogs" />
    }

    @if (_move is not null)
    {
        <MoveDialog @key="_move" Title="@($"Move \"{_move.Name}\"")" Notebooks="_notebooks" Folders="_folders" Excluded="_move.Excluded"
                    Error="@_dialogError" OnConfirm="ConfirmMoveAsync" OnCancel="CloseDialogs" />
    }

    @if (_menu is not null)
    {
        <ContextMenu Items="_menu.Items" X="_menu.X" Y="_menu.Y" Label="@_menu.Label" OnClose="() => _menu = null" />
    }

    @if (_confirm is not null)
    {
        <ConfirmDialog @key="_confirm" Title="@_confirm.Title" Message="@_confirm.Message" ConfirmText="@_confirm.ConfirmText" Danger="_confirm.Danger"
                       OnConfirm="ConfirmActionAsync" OnCancel="CloseDialogs" />
    }
</div>
