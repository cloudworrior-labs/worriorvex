@inject Translator T
<section class="wn-trash-detail" aria-label="@T["Deleted item"]">
    <p class="wn-trash-kind">@T["{0} in the trash", TrashList.KindLabel(T, Item.Kind)]</p>
    <h1>@Item.Name</h1>
    <dl>
        <dt>@T["Deleted"]</dt>
        <dd>@Item.DeletedAt.ToLocalTime().ToString("f")</dd>
        @if (Item.OriginalLocation.Length > 0)
        {
            <dt>@T["Was in"]</dt>
            <dd>@Item.OriginalLocation</dd>
        }
    </dl>
    @if (Item.Kind != TrashItemKind.Note)
    {
        <p>@T["Everything that was inside it when it was deleted comes back with it."]</p>
    }
    <div class="wn-trash-actions">
        <button type="button" class="wn-button wn-button-primary" @onclick="() => OnRestore.InvokeAsync(Item)">@T["Restore"]</button>
        <button type="button" class="wn-button wn-button-danger" @onclick="() => OnDelete.InvokeAsync(Item)">@T["Delete permanently…"]</button>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public TrashItem Item { get; set; } = default!;
    [Parameter] public EventCallback<TrashItem> OnRestore { get; set; }
    [Parameter] public EventCallback<TrashItem> OnDelete { get; set; }
}
