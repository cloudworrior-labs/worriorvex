@inject Translator T
@using WorriorVex.Application.Platform
@using WorriorVex.Application.Updates
@inject AppInfo Info
@inject IPlatformShell Shell
@inject IUpdateChecker Updates

<section class="wn-page" aria-labelledby="wn-about-title">
    <div class="wn-about-head">
        <img src="_content/WorriorVex.UI/img/worriorvex.svg" alt="" width="88" height="88" />
        <div>
            <h1 id="wn-about-title">@AppInfo.ProductName</h1>
            <p class="wn-about-tagline">@T[AppInfo.Tagline]</p>
        </div>
    </div>

    <dl class="wn-facts">
        <dt>@T["Version"]</dt>
        <dd>@Info.Version</dd>

        <dt>@T["Published by"]</dt>
        <dd>@AppInfo.Publisher</dd>

        <dt>@T["Website"]</dt>
        <dd><ExternalLink Address="AppInfo.Website">www.cloudworrior.com</ExternalLink></dd>

        <dt>@T["Source code"]</dt>
        <dd><ExternalLink Address="AppInfo.Repository">github.com/cloudworrior-labs/worriorvex</ExternalLink></dd>

        <dt>@T["Updates"]</dt>
        <dd>
            <ExternalLink Address="AppInfo.Releases">@T["Releases and downloads"]</ExternalLink>
            <button type="button" class="wn-button wn-button-small" disabled="@_checking" @onclick="CheckAsync">@(_checking ? T["Checking…"] : T["Check now"])</button>
            @if (_check is { } check)
            {
                <span>
                    @if (check.IsNewer)
                    {
                        <text>@T["Version {0} is available.", check.LatestVersion] </text><ExternalLink Address="check.DownloadPage">@T["Open the downloads page"]</ExternalLink>
                    }
                    else
                    {
                        <text>@T["You have the newest version ({0}).", check.LatestVersion]</text>
                    }
                </span>
            }
            else if (_checkFailed)
            {
                <span>@T["The release page could not be reached."]</span>
            }
        </dd>

        <dt>@T["Feedback"]</dt>
        <dd><ExternalLink Address="AppInfo.Issues">@T["Report a problem or suggest something"]</ExternalLink></dd>

        <dt>@T["Licence"]</dt>
        <dd>@AppInfo.License. @T["Free to use, change and share."]</dd>

        <dt>@T["Your data"]</dt>
        <dd>
            <code>@Info.DataDirectory</code>
            <button type="button" class="wn-button wn-button-small" @onclick="() => Shell.OpenFolder(Info.DataDirectory)">@T["Open folder"]</button>
        </dd>
    </dl>

    <p>
        @T["WorriorVex keeps your notes on this computer. It works without an internet connection, needs no account and sends nothing anywhere: no telemetry, no analytics. “Check now” above and the optional check at start ask github.com for the newest version number and nothing more."]
    </p>

    <h2>@T["Built with"]</h2>
    <ul class="wn-credits">
        <li>.NET, Blazor, Entity Framework Core (MIT)</li>
        <li>SQLite (@T["public domain"])</li>
        <li>Photino (Apache 2.0)</li>
        <li>TipTap and ProseMirror (MIT)</li>
        <li>HtmlSanitizer and AngleSharp (MIT)</li>
    </ul>

    <p class="wn-about-copyright">@AppInfo.Copyright</p>
</section>

@code {
    private UpdateCheck? _check;
    private bool _checking;
    private bool _checkFailed;

    /// <summary>Contacts github.com once, because the user asked for it here and now.</summary>
    private async Task CheckAsync()
    {
        _checking = true;
        _checkFailed = false;
        _check = await Updates.CheckAsync();
        _checkFailed = _check is null;
        _checking = false;
    }
}
