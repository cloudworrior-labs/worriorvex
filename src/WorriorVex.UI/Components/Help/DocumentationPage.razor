@inject Translator T

<div class="wn-docs">
    <nav class="wn-docs-topics" aria-label="@T["Documentation topics"]">
        <h1>@T["Documentation"]</h1>
        <ul>
            @foreach (var topic in Topics)
            {
                var selected = topic.Id == _topic;
                <li>
                    <button type="button" class="wn-navitem @(selected ? "is-selected" : null)" aria-current="@(selected ? "page" : null)"
                            @onclick="() => _topic = topic.Id">@T[topic.Title]</button>
                </li>
            }
        </ul>
    </nav>

    <article class="wn-page wn-prose-static" aria-live="polite">
        @switch (T.Language)
        {
            case "nl":
                <DocsNl Topic="@_topic" />
                break;
            case "de":
                <DocsDe Topic="@_topic" />
                break;
            case "pl":
                <DocsPl Topic="@_topic" />
                break;
            default:
                <DocsEn Topic="@_topic" />
                break;
        }
    </article>
</div>

@code {
    private static readonly (string Id, string Title)[] Topics =
    [
        ("start", "Getting started"),
        ("writing", "Writing notes"),
        ("searching", "Searching"),
        ("organising", "Notebooks and folders"),
        ("trash", "The Trash"),
        ("shortcuts", "Keyboard shortcuts"),
        ("settings", "Settings"),
        ("import", "Importing"),
        ("data", "Your data"),
        ("coming", "What is coming"),
    ];

    private string _topic = "start";
}
